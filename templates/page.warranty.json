              ]
            },
            "accordion_row_DigkqF": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "- Terms and Conditions",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_nXhAyh": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<ol><li>You are the original owner</li><li>You purchased your rod from Megabass of America or from an authorized Megabass® dealer in the US, Canada, or Mexico</li><li>You are within the warranty period of three (3) years from the purchase date</li><li>You have a copy of the original purchase receipt (contact the store you purchased from if you do not still have your receipt)</li><li>You have completed the official Warranty Claim Form and returned to us along with proof of purchase</li><li>Your rod, and a hardcopy of the completed Claim Form have been received at the designated facility</li></ol>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
