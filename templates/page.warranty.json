                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0,
                    "hidden_mobile": false
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_4QtqFE"
              ]
            },
            "accordion_row_eAFp8E": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "- Shipping policy",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_aVk4Ha": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>Please note that you are responsible for shipping from your location to our warehouse or repair facility, and it is strongly suggested that you insure and track your package. Megabass is not liable for any issues that arise in transit from your location to our facility. Megabass will cover all costs of return shipping from our facility to your location.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "",
                    "paragraph_size": "paragraph-md",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
