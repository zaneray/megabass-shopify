              ]
            },
            "accordion_row_aU76a8": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "Do you work with existing technical teams or handle everything?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_FcJGYA": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>We believe great partnerships are built on collaboration and collective success.Whether we’re providing cross-disciplinary teams or working alongside your internal experts, we adapt our approach to fit your needs.Our goal is to serve as a reliable partner, bringing curiosity and accountability to every challenge while ensuring all actions are aligned with your clear business outcomes.</p>",
                    "width": "100%",
