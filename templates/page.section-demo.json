                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_KixVXn"
              ]
            },
            "accordion_row_pf6LTY": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "How long does it take to see measurable impact from a project?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_xRgGVf": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>While every journey is unique, we’re committed to delivering purposeful outcomes that last.We prioritize \"insight to action,\" meaning we structure our projects to identify quick wins while building a foundation for long-term commerce elevation.Because our words are backed by results, we focus on dependable milestones that ensure you’re seeing a clear return on your investment.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "paragraph_size": "paragraph-md",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
