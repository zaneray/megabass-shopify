      <section id="theming-" class="container-xl">
        {% comment %} <h2>Color Schemes</h2> {% endcomment %}
        {%- assign _themes = '1,2,3,4' -%}
        {%- assign themes = _themes | split: ',' -%}
        {%- for theme in themes -%}
        <div class="color-scheme-{{ theme }} theme-block">
          <h3>.color-scheme-{{ theme }}</h3>
          <div
          class="product-badges product-badges--top-right"
          style="
            --padding-block-start: 1rem;
            --padding-inline-start: 1rem;
            --badge-border-radius: {{ settings.badge_corner_radius }}px;
            --badge-font-family: var(--font-{{ settings.badge_font_family }}--family); --badge-font-weight: var(--font-{{ settings.badge_font_family }}--weight); --badge-text-transform: {{ settings.badge_text_transform }};
          "
          >
          <div class="product-badges__badge product-badges__badge--rectangle color-{{ settings.badge_sold_out_color_scheme }}">Badge</div>
        </div>
          <p>Text Primary: Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>
          <p class="text-secondary">Text Secondary: Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>
          <a class="link" href="#">Link</a><br/><br/>
          <hr>
          <div class="grid-auto grid-rows">
            <div class="grid-item">
              <button class="button button-primary">Primary</button>
            </div>
            <div class="grid-item">
              <button class="button button-secondary">Secondary</button>
            </div>
            <div class="grid-item">
              <button class="button button-tertiary">Tertiary</button>
            </div>
          </div>
          <div class="grid-auto grid-rows">
            <div class="grid-item">
              <button class="button button-primary" disabled>Primary Disabled</button>
            </div>
            <div class="grid-item">
              <button class="button button-secondary" disabled>Secondary Disabled</button>
            </div>
            <div class="grid-item">
              <button class="button button-tertiary" disabled>Tertiary Disabled</button>
            </div>
          </div>
        </div>
        {%- endfor -%}
      </section>

      <section id="iconography-original" class="container-xl">
        <h4>Assets Folder Icons</h4>
        {%- assign asset_icons = 'account,add-to-cart,arrow,available,caret,cart,checkmark-burst,checkmark,chevron-left,chevron-right,close,delete,discount,double-chevron,error,external,filter,filters-close,grid-default,grid-dense,info,inventory,menu,minus,one-col-mobile,orders,pause,play,plus,reset,search,shopify,unavailable' -%}
        {%- assign icons = asset_icons | split: ',' -%}
        <ul class="icons list-unstyled">
          {%- for icon in icons -%}
            <li>
