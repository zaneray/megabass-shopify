<div class="style-guide-page">
  <style>
    .container-xl {
      max-width: 1200px;
      padding-inline: 4.2vw;
    }
    .style-guide .grid-auto {
      display: grid;
      grid-auto-flow: column;
      grid-auto-rows: minmax(100px, min-content);
      margin-bottom: 2rem;
      grid-gap: 2rem;
    }
		.style-guide hr {
				margin: 2rem auto 3rem;
		}
    .style-guide .grid-rows {
      grid-auto-flow: row;
      grid-template-columns: repeat(auto-fit,minmax(240px,1fr));
    }
    .style-guide .grid-large {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 2rem;
      grid-auto-rows: row;
    }
    @media (min-width: 1024px) {
      .style-guide .grid-large {
        grid-template-columns: repeat(auto-fill, minmax(460px, 1fr));
      }
    }
    .style-guide .grid-small {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 2rem;
      grid-auto-flow: row;
    }
    .style-guide .grid-item {
      width: 100%;
      max-width: 100%;
      position: relative;
      display: flex;
      flex-direction: column;
      {% comment %} align-items: center;
      justify-content: center; {% endcomment %}
    }
    .style-guide .grid-item.font-block,
    .style-guide .grid-item.button-block {
      align-items: flex-start;
    }
    .style-guide #colors .grid-item {
      text-align: left;
      display: block;
      margin-bottom: 1rem;
    }
    .style-guide #colors .grid-item p:not(.heading-6),
    .style-guide #colors .grid-item pre {
      margin: 0;
      font-size: 0.87rem;
    }
    .style-guide #colors .grid-item p.heading-6 {
      margin: 0;
    }
    .style-guide .color-block {
      display: block !important;
      width: 100%;
      height: 125px;
      margin-bottom: 1rem;
    }
    .style-guide .color-block.bg-color-white,
    .style-guide .color-block.bg-color-white {
      border: 1px solid #e7e5e5;
     }
    .style-guide .container-xl#container-spacing,
    .style-guide .container-xl#intro {
      border-bottom: none;
      padding-bottom: 0;
    }
    .style-guide .container-xl#container-spacing .container-xl {
      border: none;
    }
    .style-guide .background-block {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      height: 33vh;
      margin-bottom: 2rem;
      padding: 2rem;
      text-align: center;
    }
    .style-guide .icons li {
      margin: 0.5rem;
    }
    .style-guide .icons {
      overflow: auto;
      padding-bottom: 2rem;
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .style-guide p[class$="-font-stack"] {
      word-break: break-all;
    }
    .style-guide .theme-block {
      position: relative;
      padding: 2rem 2rem 4rem;
      margin-bottom: 2rem;
    }
    .style-guide .theme-block .badge {
      position: absolute;
      top: 2rem;
      right: max(1rem, 3vw);
    }
    .style-guide pre {
      white-space: break-spaces;
    }
    .style-guide-container {
      background: var(--color-primary-200);
    }
    .alert-container {
      width: 100%;
    }
    .container-padding {
      padding: var(--container-padding);
    }
    .field-with-focus .field-input {
      border-color: var(--input-border-active);
      outline: 3px solid var(--input-focus-active);
    }
