<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section section--{{ section.settings.section_width }}">
  {% liquid
    assign total_blocks = section.blocks.size

    # Grid layout calculations
    assign grid_columns = total_blocks | at_most: 4

    # Calculate last row counts using modulo arithmetic
    # last_row_count = (total_blocks - 1) % N + 1
    assign last_row_count = total_blocks | minus: 1 | modulo: 4 | plus: 1
    assign tablet_last_row_count = total_blocks | minus: 1 | modulo: 2 | plus: 1

    # Check if there are orphaned elements (single item in last row)
    assign has_isolated_grid_item_desktop = false
    assign has_isolated_grid_item_tablet = false

    if total_blocks > 4 and last_row_count == 1
      assign has_isolated_grid_item_desktop = true
    endif

    if total_blocks == 5
      assign has_isolated_grid_item_tablet = true
    endif
  %}
  <div
    class="
      footer-content
      spacing-style
      color-{{ section.settings.color_scheme }}
      {% if has_isolated_grid_item_desktop %}footer-content--isolated-grid-item-desktop{% endif %}
      {% if has_isolated_grid_item_tablet %}footer-content--isolated-grid-item-tablet{% endif %}
    "
    style="
      {% render 'spacing-style', settings: section.settings %}
      --gap: {{ section.settings.gap }}px;
      --footer-gap-mobile: {{ section.settings.gap-mobile }}px;
      --grid-columns: {{ grid_columns }};
      --last-row-count: {{ last_row_count }};
      --tablet-last-row-count: {{ tablet_last_row_count }};
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .footer-content {
    display: flex;
    flex-direction: column;
    gap: var(--footer-gap-mobile);
  }

  @media (max-width: 749px) {
    .footer-content {
      .footer-navigation {
        .layout-panel-flex {
          gap: 0;
        }

        /* Horizontal dividers between accordion items */
        .group-block-content > .menu--dividers .menu__details {
          border-block-start: var(--style-border-width) solid var(--color-border);
          border-block-end: none;
        }
        
        /* Bottom border only on the last menu in the stack */
        .group-block-content > .menu--dividers:last-child .menu__details {
          border-block-end: var(--style-border-width) solid var(--color-border);
        }

        .group-block-content .menu {
          width: 100%;
        }

        summary {
          &.menu__heading {
            padding: 1rem 0;
            text-transform: uppercase;
          }
        }
      }
    }
  }

  @media (min-width: 750px) {
    .footer-content {
      display: grid;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .footer-content {
      grid-template-columns: repeat(var(--grid-columns), 1fr);
      grid-auto-flow: row;
    }

    .footer-content[style*='--grid-columns: 3'] > :first-child {
      order: 2;
      grid-column: 1 / 2;
    }

    .footer-content[style*='--grid-columns: 3'] > :nth-child(2) {
      order: 3;
      grid-column: 2 / -1;
    }

    .footer-content[style*='--grid-columns: 3'] > :last-child {
      order: 1;
      grid-column: 1 / -1;
    }

    .footer-content[style*='--grid-columns: 4'] {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-content--isolated-grid-item-tablet > :last-child {
      grid-column: 1 / -1;
    }

    .footer-navigation .group-block-content {
      flex-wrap: wrap;
      /* or: display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); */
    }

    .footer-navigation .menu {
      min-width: 0;
      flex: 1 1 calc(50% - var(--gap) / 2); /* if using flex-wrap */
    }
  }

  @media screen and (min-width: 990px) {
    .footer-content {
      grid-template-columns: repeat(var(--grid-columns), auto);
      gap: var(--footer-gap);
    }

    /* .footer-content[style*='--grid-columns: 3'] {
      grid-template-columns: auto minmax(0, 1fr) auto;
    } */

    /* Single item centered */
    .footer-content[style*='--grid-columns: 1'] {
      justify-items: center;
    }

    .footer-content > :first-child {
      grid-column: 1 / 2;
    }

    .footer-content > :nth-child(2) {
      order: 2;
      grid-column: 2 / 3;
    }

    .footer-content[style*='--grid-columns: 3'] > :last-child {
      order: 3;
      grid-column: 3 / -1;
    }

    .email-signup-block {
      min-width: 0;
      max-width: 100%;
    }

    .footer-content--isolated-grid-item-desktop > :last-child {
      grid-column: 1 / -1;
    }
  }

  .footer-content {
    .group-block.footer-logo {
      order: 1;
      grid-column: 1 / -1;
      align-self: center;
    }

    .group-block.footer-navigation {
      order: 2;
      grid-column: 1 / -1;
    }

    .group-block.email-signup-and-social {
      order: 3;
      grid-column: 1 / -1;

      .h3.paragraph-md {
        margin-bottom: 0;
      }

     .rte.paragraph-sm {
        margin-bottom: var(--text-spacing-md);
      }

      .social-icons__wrapper {
        margin-top: var(--text-spacing-md);
      }
    }
  }

  @media (max-width: 749px) {
    .footer-content {
      .group-block-content .menu {
        width: 100%;
      }

      .rte.paragraph-sm.text-block > * {
        --text-align-mobile: center;
        text-align: var(--text-align-mobile);
      }
    }
  }

  @media (min-width: 750px) {
    .footer-content {      
      .group-block.footer-logo {
        align-self: inherit;
      }
    }
  }
  
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .footer-content {
      .group-block.footer-logo {
        order: 2;
        grid-column: 1 / 2;
        width: fit-content;
      }

      .group-block.footer-navigation {
        order: 3;
        grid-column: 2 / 3;
      }

      .group-block.email-signup-and-social {
        order: 1;
        grid-column: 1 / -1;
      }
    }
  }

  @media (min-width: 990px) {
    .footer-content {
      .group-block.footer-logo {
        order: 1;
        grid-column: 1 / 2;
        width: fit-content;
      }

      .group-block.footer-navigation {
        order: 2;
        grid-column: 2 / 3;
      }

      .group-block.email-signup-and-social {
        order: 3;
        grid-column: 3 / -1;
      }
    }
  }

  .footer-navigation {
    .menu__item.paragraph {
      margin-bottom: var(--text-spacing-sm);
      padding: 0;
    }

    .menu__item.paragraph > * {
      margin: 0;
      padding: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.footer",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "_divider"
    },
    {
      "type": "@app"
    },
    {
      "type": "button"
    },
    {
      "type": "follow-on-shop"
    },
    {
      "type": "group"
    },
    {
      "type": "group-grid"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "menu"
    },
    {
      "type": "payment-icons"
    },
    {
      "type": "text"
    },
    {
      "type": "logo"
    },
    {
      "type": "jumbo-text"
    },
    {
      "type": "social-links"
    },
    {
      "type": "email-signup"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "gap-mobile",
      "label": "t:settings.gap_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48,
      "info": "t:settings_info.mobile_gap"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.footer",
      "category": "t:categories.footer",
      "settings": {
        "padding-block-start": 0,
        "padding-block-end": 0,
        "padding-inline-start": 0,
        "padding-inline-end": 0
      }
    }
  ]
}
{% endschema %}
