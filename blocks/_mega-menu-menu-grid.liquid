{%- doc -%}
  Renders a mega menu grid of menus with up to 6 columns.
{%- enddoc -%}

{% liquid
  assign block_settings = block.settings
%}

<div class="mega-menu-menu-grid">
  {% for i in (1..6) %}
    {% assign menu_key = 'menu_' | append: i %}
    {% assign heading_key = 'heading_' | append: i %}
    {% assign heading_link_key = 'heading_link_' | append: i %}
    {% assign collection_style_key = 'collection_links_style_' | append: i %}
    {% assign menu = block_settings[menu_key] %}
    {% assign heading = block_settings[heading_key] %}
    {% assign heading_link = block_settings[heading_link_key] %}
    {% assign collection_style = block_settings[collection_style_key] %}
    
    {% if menu != blank or heading != blank %}
      <div class="menu-column menu__details">
        {% if heading != blank %}
          <h3 class="menu-column__heading">
            {% if heading_link != blank %}
              <a class="menu-column__heading-link" href="{{ heading_link }}">{{ heading }}</a>
            {% else %}
              {{ heading }}
            {% endif %}
          </h3>
        {% endif %}
        
        {% if menu %}
          <ul class="list-unstyled menu-column__list{% if collection_style %} collection-links{% endif %}">
            {% for link in menu.links %}
              <li class="menu__item">
                <a class="link-unstyled{% if link.title contains 'sale' or link.title contains 'Sale' %} sale{% endif %}" href="{{ link.url }}">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    {% endif %}
  {% endfor %}
</div>

