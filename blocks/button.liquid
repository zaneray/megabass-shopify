{% render 'button', link: block.settings.link, block: block %}

{% schema %}
{
  "name": "t:names.button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "t:text_defaults.button_label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.open_new_tab",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "t:settings.uppercase",
      "default": false
    },
    {
      "type": "select",
      "id": "style_class",
      "label": "t:settings.style",
      "options": [
        {
          "value": "button-primary",
          "label": "t:options.primary"
        },
        {
          "value": "button-secondary",
          "label": "t:options.secondary"
        },
        {
          "value": "button-tertiary",
          "label": "t:options.tertiary"
        },
        {
          "value": "link",
          "label": "t:options.link"
        }
      ],
      "default": "button-primary"
    },
    {
      "type": "header",
      "content": "t:content.icon"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "arrow-right",
          "label": "t:options.arrow_right"
        },
        {
          "value": "arrow-left",
          "label": "t:options.arrow_left"
        },
        {
          "value": "arrow-up",
          "label": "t:options.arrow_up"
        },
        {
          "value": "arrow-down",
          "label": "t:options.arrow_down"
        },
        {
          "value": "caret-right",
          "label": "t:options.caret_right"
        },
        {
          "value": "caret-left",
          "label": "t:options.caret_left"
        },
        {
          "value": "caret-up",
          "label": "t:options.caret_up"
        },
        {
          "value": "caret-down",
          "label": "t:options.caret_down"
        },
        {
          "value": "download",
          "label": "t:options.download"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "t:settings.icon_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "right",
      "info": "t:settings.icon_position_info",
      "visible_if": "{{ block.settings.icon != 'none' }}"
    },
    {
      "type": "select",
      "id": "icon_size",
      "label": "t:settings.icon_size",
      "options": [
        {
          "value": "xsmall2",
          "label": "t:options.xxsmall"
        },
        {
          "value": "xsmall",
          "label": "t:options.xsmall"
        },
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        } 
      ],
      "default": "xsmall",
      "visible_if": "{{ block.settings.icon != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == \"custom\" }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == \"custom\" }}"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "t:text_defaults.button_size",
      "options": [
        {
          "value": "button-sm",
          "label": "t:options.small"
        },
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "button-lg",
          "label": "t:options.large"
        }
      ],
      "default": ""
    }
  ],
  "presets": [
    {
      "name": "t:names.button",
      "category": "t:categories.basic",
      "settings": {
        "link": "shopify://collections/all"
      }
    }
  ]
}
{% endschema %}
