{%- doc -%}
  Renders the help icon, which links to the help page.
{%- enddoc -%}

{%- if block.settings.link != blank -%}
  <a
    href="{{ block.settings.link }}"
    class="header-actions__action help-header-icon link-unstyled {{ css_class }}"
    title="{{ 'names.help_header_icon' | t }}"
		data-tooltip="{{ 'names.help_header_icon' | t }}"
		data-tooltip-position="top"
  >
    {{- 'icon-help.svg' | inline_asset_content -}}
		<span class="navigation-desktop:hidden">{{ 'names.help_header_icon' | t }}</span>
  </a>
{%- endif -%}

{% schema %}
{
  "name": "t:names.help_header_icon",
	"tag": null,
	"settings": [
		{
			"type": "url",
			"id": "link",
			"label": "t:settings.link"
		}
	],
	"presets": [
		{
			"name": "t:names.help_header_icon"
		}
	],
}
{% endschema %}

{% stylesheet %}
	.help-header-icon {
		position: relative;
		display: flex;
		gap: 0.5rem;
		align-items: center;
	}

  .help-header-icon.header-actions__action svg {
		--button-size: var(--icon-size-lg);
		
    height: var(--button-size);
    width: var(--button-size);
  }
{% endstylesheet %}