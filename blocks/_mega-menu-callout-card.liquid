      {%- endif -%}
        <div id="Card-{{ section.id }}-{{ block.id }}-3" class="callout-card">
          <div class="media callout-card-media-menu{% if card_image_3 == blank %} placeholder{% endif %} {{ media_class }}">
            {%- if card_image_3 -%}
              {{ card_image_3 | image_url: width: 600 | image_tag: loading: 'lazy', alt: card_image_3.alt | escape }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="mega-menu-callout-card-info color-{{ color_scheme_3 }}">
            {%- if card_heading_3 != blank -%}
              {{ card_heading_3 }}
            {%- endif -%}
            {%- if card_text_3 != blank -%}
              <p class="paragraph-sm">{{ card_text_3 }}</p>
            {%- endif -%}
            {%- if button_label_3 != blank and button_link_3 != blank -%}
              <a href="{{ button_link_3 }}" class="button button-primary button-sm">{{ button_label_3 }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- if card_link_3 != blank -%}
        </a>
      {%- endif -%}
    </li>
  {%- endif -%}

  {% comment %} Card 4 {% endcomment %}
  {%- if card_image_4 != blank or card_heading_4 != blank or card_text_4 != blank -%}
    <li class="mega-menu-callout-card">
      {%- if card_link_4 != blank -%}
