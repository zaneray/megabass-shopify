      {%- endif -%}
        <div id="Card-{{ section.id }}-{{ block.id }}-4" class="callout-card">
          <div class="media callout-card-media-menu{% if card_image_4 == blank %} placeholder{% endif %} {{ media_class }}">
            {%- if card_image_4 -%}
              {{ card_image_4 | image_url: width: 600 | image_tag: loading: 'lazy', alt: card_image_4.alt | escape }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="mega-menu-callout-card-info color-{{ color_scheme_4 }}">
            {%- if card_heading_4 != blank -%}
              {{ card_heading_4 }}
            {%- endif -%}
            {%- if card_text_4 != blank -%}
              <p class="paragraph-sm">{{ card_text_4 }}</p>
            {%- endif -%}
            {%- if button_label_4 != blank and button_link_4 != blank -%}
              <a href="{{ button_link_4 }}" class="button button-primary button-sm">{{ button_label_4 }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- if card_link_4 != blank -%}
        </a>
      {%- endif -%}
    </li>
  {%- endif -%}
</ul>

{% stylesheet %}
  ul.mega-menu-callout-card-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;

    @media screen and (min-width: 1024px) {
      flex-direction: row;
    }

    @media screen and (min-width: 1440px) {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }

    &[data-card-count="3"],
    &[data-card-count="4"] {
      @media screen and (min-width: 1024px) {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    /* If there are 3 or 4 cards, display them in a 2x2 grid on desktop */
    &[data-card-count="3"] {
      @media screen and (min-width: 1440px) {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    &[data-card-count="4"] {
      @media screen and (min-width: 1440px) {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    /* If there's only 1 card, center it in the second column */
    &[data-card-count="1"] li:only-child {
      grid-column: 2;
    }
  }

  .mega-menu-callout-card {
    border-radius: var(--radius-md, 0.25rem);
    overflow: hidden;
    
    @media screen and (min-width: 992px) {
      max-width: 325px;
    }
  }
  
  .callout-card-media-menu {
    position: relative;
  }
  
  .callout-card-media-menu img::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.20) 0%, rgba(0, 0, 0, 0.20) 100%);
    pointer-events: none;
  }
  
  .mega-menu-callout-card-info {
    display: flex;
    padding: 1rem;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 0.625rem;
    flex: 1 0 0;
    white-space: wrap;
  }
{% endstylesheet %}

