

{%- doc -%}
  Renders a simple link list from a Shopify menu.
  Designed for use in announcement bar and mega menu.
  
  @param {link_list} menu - Shopify menu/link list to display
  @param {string} [direction] - Layout direction: horizontal, vertical
  @param {string} [alignment] - Text alignment: left, center, right
  @param {number} [gap] - Spacing between links
{%- enddoc -%}

{% liquid
  assign block_settings = block.settings
  assign menu = block_settings.menu
  assign direction = block_settings.direction
  assign alignment = block_settings.alignment
  assign gap = block_settings.gap
%}

{% if menu != blank %}
  <nav 
    class="
      link-list 
      link-list--{{ direction }} 
      link-list--{{ alignment }}
      custom-typography
      {% if block_settings.font_size != '' %}custom-font-size{% endif %}
      {% if block_settings.weight != '' %}custom-font-weight{% endif %}
    " 
    style="
      {% render 'typography-style', settings: block_settings, preset: 'custom' %}
      --link-list-gap: {{ gap }}px;
    "
    {{ block.shopify_attributes }}
  >
    <ul class="link-list__items list-unstyled">
      {% for link in menu.links %}
        <li class="link-list__item">
          <a 
            href="{{ link.url }}" 
            class="link-list__link"
            {% if link.current %}aria-current="page"{% endif %}
          >
            {{ link.title }}
          </a>
        </li>
      {% endfor %}
    </ul>
  </nav>
{% endif %}

{% stylesheet %}
  .link-list {
    width: 100%;
  }

  .link-list__items {
    display: flex;
    gap: var(--link-list-gap);
  }

  /* Horizontal layout (default) */
  .link-list--horizontal .link-list__items {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
  }

  /* Vertical/Column layout */
  .link-list--vertical .link-list__items {
    flex-direction: column;
    align-items: flex-start;
  }

  /* Alignment - horizontal */
  .link-list--horizontal.link-list--left .link-list__items {
    justify-content: flex-start;
  }

  .link-list--horizontal.link-list--center .link-list__items {
    justify-content: center;
  }

  .link-list--horizontal.link-list--right .link-list__items {
    justify-content: flex-end;
  }

  /* Alignment - vertical */
  .link-list--vertical.link-list--left .link-list__items {
    align-items: flex-start;
  }

  .link-list--vertical.link-list--center .link-list__items {
    align-items: center;
  }

  .link-list--vertical.link-list--right .link-list__items {
    align-items: flex-end;
  }

  .link-list__item {
    display: inline-flex;
  }

  .link-list__link {
    text-decoration: none;
    white-space: nowrap;
    transition: opacity var(--animation-speed) var(--animation-easing);
  }

  .link-list__link:hover {
    opacity: 0.7;
  }

  .link-list__link[aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  /* Mobile adjustments */
  @media screen and (max-width: 991px) {
    .link-list__items {
      font-size: 0.875rem;
    }
  }
{% endstylesheet %}

